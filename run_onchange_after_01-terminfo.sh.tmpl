#!/usr/bin/env sh
# Compile the sources in terminfo/ into ~/.terminfo with this host's tic, so
# each machine gets its native layout (hex dirs on macOS, letter dirs on Linux).
{{ range (glob (joinPath .chezmoi.sourceDir "terminfo" "*.terminfo")) -}}
# {{ base . }} sha256: {{ include . | sha256sum }}
{{ end -}}
set -eu

if ! command -v tic >/dev/null 2>&1; then
    printf 'tic not found; skipping terminfo install\n' >&2
    exit 0
fi

dest="$HOME/.terminfo"
mkdir -p "$dest"

# Earlier versions shipped prebuilt entries in letter dirs and pointed hex
# dirs at them with symlinks. Remove the symlinks so tic writes real dirs.
for entry in "$dest"/[0-9a-f][0-9a-f]; do
    if [ -L "$entry" ]; then
        rm "$entry"
    fi
done
{{- if eq .chezmoi.os "darwin" }}

# tic writes hex dirs here, so the old letter-dir copies would only shadow
# or duplicate the fresh entries.
rm -f "$dest/w/wezterm" "$dest/x/xterm-ghostty" "$dest/x/xterm-kitty"
rmdir "$dest/w" "$dest/x" 2>/dev/null || true
{{- end }}

for src in "{{ joinPath .chezmoi.sourceDir "terminfo" }}"/*.terminfo; do
    tic -x -o "$dest" "$src"
done
