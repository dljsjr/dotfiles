#!/usr/bin/env sh
{{ if ne .chezmoi.os "darwin" -}}
# Machine-born ssh identity: non-darwin machines use a key generated on the
# box itself, named after the machine (see private_dot_ssh/config.tmpl, which
# references the same hostname-derived name off darwin). The private key never
# leaves this machine; register the public key with services instead of
# transporting vault keys around.
KEYFILE="$HOME/.ssh/id_{{ .chezmoi.hostname }}"

if ! [ -f "$KEYFILE" ]
then
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    printf "Generating machine ssh key %s\n" "$KEYFILE"
    ssh-keygen -t ed25519 -N "" -C "{{ .chezmoi.username }}@{{ .chezmoi.hostname }} machine key" -f "$KEYFILE"

    printf "\nNew machine public key:\n\n"
    cat "$KEYFILE.pub"
    cat <<EOF

Register it where this machine needs access, e.g.:
  gh ssh-key add "$KEYFILE.pub" --title "{{ .chezmoi.hostname }} machine key"
  glab ssh-key add "$KEYFILE.pub" --title "{{ .chezmoi.hostname }} machine key"
  ...and authorized_keys on any personal hosts.
EOF
fi
{{ end -}}
