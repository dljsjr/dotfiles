  <script>
    let state = { tasks: [], statuses: [], initialProject: 'ALL', repo: '', tabs: [] };
    let filters = { q: '', project: null, kinds: new Set(), priorities: new Set(), assignees: new Set() };
    const collapsedLanesByTab = new Map();
    function activeCollapsedLanes() { const active = (state.tabs || []).find(tab => tab.active); const key = active?.id || state.repo || '__initial__'; if (!collapsedLanesByTab.has(key)) collapsedLanesByTab.set(key, new Set()); return collapsedLanesByTab.get(key); }
    let filtersInitialized = false;
    let highlighted = new Set();
    let currentDetailKey = null;
    let pendingScrollKey = null;
    let toastTimer = null;
    const fallbackStatuses = ${JSON.stringify(statuses)};
    const priorityInfo = { HIGH: { emoji: '🔥', color: '#ef4444' }, MEDIUM: { emoji: '⚡', color: '#f59e0b' }, LOW: { emoji: '🌱', color: '#22c55e' } };
    const kindInfo = { BUG: { emoji: '🐞', color: '#ef4444' }, TASK: { emoji: '📋', color: '#3b82f6' }, SUBTASK: { emoji: '🧩', color: '#8b5cf6' } };
    const assigneeEmoji = { AGENT: '🤖', USER: '👤', UNASSIGNED: '○' };
    function esc(s) { return String(s).replaceAll('&', '&amp;').replaceAll('<', '&lt;').replaceAll('>', '&gt;').replaceAll('"', '&quot;'); }
    function titleStatus(status) { return status.toLowerCase().replace(/(^| )\\w/g, c => c.toUpperCase()); }
    function activeTasks() { return state.tasks.filter(task => task.status !== 'COMPLETE'); }
    function byKey() { return new Map(state.tasks.map(task => [task.key, task])); }
    function taskHaystack(task) { return [task.key, task.project, task.title, task.kind, task.priority, task.assignee, task.reporter, task.parent].concat(task.dependsOn || [], task.blockedBy || [], task.related || []).filter(Boolean).join(' ').toLowerCase(); }
    function filteredActiveTasks() { const q = filters.q.trim().toLowerCase(); return activeTasks().filter(task => { if (filters.project && filters.project !== 'ALL' && task.project !== filters.project) return false; if (filters.kinds.size && !filters.kinds.has(task.kind)) return false; if (filters.priorities.size && !filters.priorities.has(task.priority)) return false; if (filters.assignees.size && !filters.assignees.has(task.assignee)) return false; if (q && !taskHaystack(task).includes(q)) return false; return true; }); }
    function mapChildren(tasks) { const map = new Map(); for (const task of tasks) { if (!task.parent) continue; if (!map.has(task.parent)) map.set(task.parent, []); map.get(task.parent).push(task); } return map; }
    function renderFilterControls() { const projects = [...new Set(state.tasks.map(task => task.project))].sort(); const projectSelect = document.getElementById('project'); const previousProject = filters.project ?? state.initialProject; projectSelect.innerHTML = '<option value="ALL">All projects</option>' + projects.map(project => '<option value="' + esc(project) + '">' + esc(project) + '</option>').join(''); filters.project = previousProject === 'ALL' ? 'ALL' : (projects.includes(previousProject) ? previousProject : (projects.includes(state.initialProject) ? state.initialProject : 'ALL')); projectSelect.value = filters.project; renderChipGroup('kindFilters', ['BUG', 'TASK', 'SUBTASK'], filters.kinds, kind => (kindInfo[kind]?.emoji ?? '') + ' ' + kind); renderChipGroup('priorityFilters', ['HIGH', 'MEDIUM', 'LOW'], filters.priorities, priority => (priorityInfo[priority]?.emoji ?? '') + ' ' + priority); const assignees = [...new Set(state.tasks.map(task => task.assignee))].sort(); renderChipGroup('assigneeFilters', assignees, filters.assignees, assignee => (assigneeEmoji[assignee] ?? '○') + ' ' + assignee); }
    function renderChipGroup(id, values, selected, labelFor) { const el = document.getElementById(id); el.innerHTML = values.map(value => '<button class="filter-chip' + (selected.has(value) ? ' active' : '') + '" data-value="' + esc(value) + '" type="button">' + esc(labelFor(value)) + '</button>').join(''); el.querySelectorAll('.filter-chip').forEach(chip => chip.addEventListener('click', () => { const value = chip.dataset.value; if (selected.has(value)) selected.delete(value); else selected.add(value); render(); })); }
    function renderTabs() { const tabs = state.tabs || []; const el = document.getElementById('tabs'); if (!tabs.length) { el.innerHTML = ''; return; } el.innerHTML = tabs.map(tab => '<div class="repo-tab' + (tab.active ? ' active' : '') + (tab.changed ? ' changed' : '') + (tab.error ? ' error' : '') + '" draggable="true" data-tab-shell-id="' + esc(tab.id) + '" title="' + esc(tab.repo) + '"><button class="tab-main" data-tab-id="' + esc(tab.id) + '" type="button"><span class="tab-label">' + esc(tab.label || tab.repo) + '</span><span class="tab-count">' + esc(tab.count ?? 0) + '</span>' + (tab.changed && !tab.active ? '<span class="tab-unread" title="Changed while inactive"></span>' : '') + '</button><button class="tab-close" data-close-tab-id="' + esc(tab.id) + '" type="button" title="Close tab">×</button></div>').join(''); el.querySelectorAll('[data-tab-id]').forEach(tab => tab.addEventListener('click', () => window.glimpse.send({ type: 'switchTab', tabId: tab.dataset.tabId }))); el.querySelectorAll('[data-close-tab-id]').forEach(button => button.addEventListener('click', event => { event.stopPropagation(); window.glimpse.send({ type: 'closeTab', tabId: button.dataset.closeTabId }); })); installTabDragHandlers(el); }
    function consistencyWarnings() { const tasks = state.tasks; const map = byKey(); const warnings = []; for (const task of tasks) { if (task.parent) { const parent = map.get(task.parent); if (parent?.status === 'COMPLETE' && task.status !== 'COMPLETE') warnings.push({ key: task.key, text: task.key + ' active under complete parent ' + parent.key }); } if (task.status === 'NEEDS REVIEW' || task.status === 'COMPLETE') { for (const blocker of task.blockedBy || []) { const blockerTask = map.get(blocker); if (!blockerTask || blockerTask.status !== 'COMPLETE' || blockerTask.resolution !== 'DONE') warnings.push({ key: task.key, text: task.key + ' is ' + titleStatus(task.status) + ' with unresolved blocker ' + blocker }); } } } return warnings; }
    function renderChangeNotices() { const box = document.getElementById('changeNotices'); const notices = state.changeNotices || []; if (!notices.length) { box.innerHTML = ''; return; } box.innerHTML = '<div class="change-notice-toolbar"><span>' + notices.length + ' unread change notice' + (notices.length === 1 ? '' : 's') + '</span><button id="markAllChangeNoticesRead" type="button">Mark all as read</button></div>' + notices.map(notice => '<article class="change-notice"><button class="change-notice-close" data-dismiss-change="' + esc(notice.id) + '" type="button" title="Dismiss">×</button><h3>Changes while you were away</h3><p>' + esc(notice.summary) + ' • ' + esc(new Date(notice.createdAt).toLocaleTimeString()) + '</p><ul>' + (notice.details || []).map(detail => '<li>' + esc(detail) + '</li>').join('') + (notice.hiddenCount ? '<li>…and ' + esc(notice.hiddenCount) + ' more</li>' : '') + '</ul></article>').join(''); document.getElementById('markAllChangeNoticesRead')?.addEventListener('click', () => window.glimpse.send({ type: 'dismissAllChangeNotices' })); box.querySelectorAll('[data-dismiss-change]').forEach(button => button.addEventListener('click', () => window.glimpse.send({ type: 'dismissChangeNotice', noticeId: button.dataset.dismissChange }))); }
    function renderWarnings() { const box = document.getElementById('warnings'); const list = document.getElementById('warningList'); const warnings = consistencyWarnings(); box.classList.toggle('visible', warnings.length > 0); list.innerHTML = warnings.map(w => '<button class="warning-chip" data-key="' + esc(w.key) + '">⚠ ' + esc(w.text) + '</button>').join(''); list.querySelectorAll('.warning-chip').forEach(chip => chip.addEventListener('click', () => focusKey(chip.dataset.key))); }
    function installTabDragHandlers(container) { container.querySelectorAll('[data-tab-shell-id]').forEach(tab => { tab.addEventListener('dragstart', event => { event.dataTransfer.setData('text/plain', tab.dataset.tabShellId); event.dataTransfer.effectAllowed = 'move'; tab.classList.add('dragging'); }); tab.addEventListener('dragend', () => { tab.classList.remove('dragging'); container.querySelectorAll('.drop-before').forEach(el => el.classList.remove('drop-before')); }); tab.addEventListener('dragover', event => { event.preventDefault(); event.dataTransfer.dropEffect = 'move'; container.querySelectorAll('.drop-before').forEach(el => el.classList.remove('drop-before')); tab.classList.add('drop-before'); }); tab.addEventListener('dragleave', () => tab.classList.remove('drop-before')); tab.addEventListener('drop', event => { event.preventDefault(); event.stopPropagation(); tab.classList.remove('drop-before'); const dragged = event.dataTransfer.getData('text/plain'); if (dragged) window.glimpse.send({ type: 'reorderTab', tabId: dragged, beforeTabId: tab.dataset.tabShellId }); }); }); container.addEventListener('dragover', event => { event.preventDefault(); }); container.addEventListener('drop', event => { if (event.target.closest('[data-tab-shell-id]')) return; event.preventDefault(); const dragged = event.dataTransfer.getData('text/plain'); if (dragged) window.glimpse.send({ type: 'reorderTab', tabId: dragged, beforeTabId: null }); }); }
    function render() { if (!filtersInitialized) { filters.project = state.initialProject ?? 'ALL'; document.getElementById('search').value = filters.q; filtersInitialized = true; } renderTabs(); renderFilterControls(); renderChangeNotices(); renderWarnings(); document.getElementById('repoPath').textContent = state.repo ? 'Repo: ' + state.repo : 'Repo: —'; const board = document.getElementById('board'); if (!(state.tabs || []).length) { board.innerHTML = '<div class="empty-board"><h2>No repositories open</h2><p>Use Open repo to browse for a repository with <code>.sandpiper/tasks</code>.</p></div>'; document.getElementById('summary').textContent = 'No repos open'; return; } const statuses = state.statuses.length ? state.statuses : fallbackStatuses; const active = filteredActiveTasks(); const allChildrenByParent = mapChildren(state.tasks); const visibleChildrenByParent = mapChildren(active); const parentByKey = byKey(); const activeTopLevel = active.filter(task => !task.parent && task.kind !== 'SUBTASK'); const standalone = activeTopLevel.filter(task => !(allChildrenByParent.get(task.key)?.length)); const parentKeys = [...visibleChildrenByParent.keys()]; const lanes = [{ type: 'standalone', key: 'standalone', tasks: standalone }].concat(parentKeys.map(key => ({ type: 'parent', key, parent: parentByKey.get(key), tasks: visibleChildrenByParent.get(key) || [] })).filter(lane => lane.parent)).filter(lane => lane.tasks.length || lane.type === 'standalone'); if (!active.length) board.innerHTML = '<div class="empty-board"><h2>No active tasks match these filters</h2><p>Try broadening project, search, kind, priority, or assignee.</p></div>'; else board.innerHTML = lanes.map(lane => laneHTML(lane, statuses)).join(''); installLaneToggles(); installDragHandlers(); if (pendingScrollKey) { const key = pendingScrollKey; pendingScrollKey = null; scrollCardIntoView(key); } const counts = Object.fromEntries(statuses.map(status => [status.key, active.filter(task => task.status === status.key).length])); document.getElementById('summary').textContent = active.length + ' visible • ' + (counts['NOT STARTED'] || 0) + ' todo • ' + (counts['IN PROGRESS'] || 0) + ' doing • ' + (counts['NEEDS REVIEW'] || 0) + ' review'; }
    function laneHTML(lane, statuses) { const collapsed = activeCollapsedLanes().has(lane.key); const body = collapsed ? '<div class="collapsed-summary">' + lane.tasks.length + ' cards hidden in this row.</div>' : '<div class="lane-body">' + statuses.map(status => statusColumnHTML(lane, status, lane.tasks.filter(task => task.status === status.key))).join('') + '</div>'; return '<section class="lane' + (collapsed ? ' collapsed' : '') + '">' + laneHeaderHTML(lane, collapsed) + body + '</section>'; }
    function laneHeaderHTML(lane, collapsed) { const toggle = '<button class="lane-collapse" data-toggle-lane="' + esc(lane.key) + '" type="button" title="' + (collapsed ? 'Expand row' : 'Collapse row') + '">' + (collapsed ? '▸' : '▾') + '</button>'; if (lane.type === 'standalone') return '<header class="lane-header top"><div><p class="lane-kicker">Standalone swimlane</p><h2 class="lane-title">📌 Tasks/Bugs without subtasks</h2></div><div class="lane-meta"><span class="badge">' + lane.tasks.length + ' cards</span><span class="badge">Click for details</span><span class="badge">Use ↕ to drag</span>' + toggle + '</div></header>'; const task = lane.parent; const priority = priorityInfo[task.priority] || priorityInfo.LOW; const kind = kindInfo[task.kind] || kindInfo.TASK; const assignee = assigneeEmoji[task.assignee] || '○'; return '<header class="lane-header" style="--priority-color:' + priority.color + '; --kind-color:' + kind.color + '"><div><p class="lane-kicker">Parent swimlane • ' + esc(task.project) + ' • ' + esc(titleStatus(task.status)) + '</p><h2 class="lane-title">' + esc(task.title) + '</h2></div><div class="lane-meta"><span class="badge project">' + esc(task.project) + '</span><span class="badge key">' + esc(task.key) + '</span><span class="badge kind">' + kind.emoji + ' ' + esc(task.kind) + '</span><span class="badge priority">' + priority.emoji + ' ' + esc(task.priority) + '</span><span class="badge assignee">' + assignee + ' ' + esc(task.assignee) + '</span><span class="badge">' + lane.tasks.length + ' children</span><button class="card-tool subtask lane-tool" data-add-subtask="' + esc(task.key) + '" type="button">Add subtask</button>' + toggle + '</div></header>'; }
    function statusColumnHTML(lane, status, tasks) { return '<section class="status-column" style="--status-color:' + esc(status.accent) + '"><div class="status-head"><span>' + esc(status.title) + '</span><span>' + tasks.length + '</span></div><div class="cards" data-status="' + esc(status.key) + '" data-lane="' + esc(lane.key) + '" style="--status-color:' + esc(status.accent) + '">' + (tasks.length ? tasks.map(cardHTML).join('') : '<div class="empty">Drop cards here</div>') + '</div></section>'; }
    function cardHTML(task) { const priority = priorityInfo[task.priority] || priorityInfo.LOW; const kind = kindInfo[task.kind] || kindInfo.TASK; const assignee = assigneeEmoji[task.assignee] || '○'; const relationCount = (task.dependsOn?.length || 0) + (task.blockedBy?.length || 0) + (task.related?.length || 0); const blocked = (task.blockedBy?.length || 0) > 0; const hi = highlighted.has(task.key) ? ' highlighted' : ''; const canHaveSubtasks = task.kind !== 'SUBTASK'; return '<article class="card ' + (canHaveSubtasks ? 'has-corner ' : '') + 'kind-' + esc(String(task.kind).toLowerCase()) + (blocked ? ' blocked' : '') + hi + '" data-key="' + esc(task.key) + '" style="--priority-color:' + priority.color + '; --kind-color:' + kind.color + '" title="Click for details: ' + esc(task.title) + '"><div class="drag-strip" draggable="true" data-key="' + esc(task.key) + '" title="Drag to change status"><span class="drag-icon">✥</span></div>' + (canHaveSubtasks ? '<button class="card-tool subtask corner-tool" data-add-subtask="' + esc(task.key) + '" type="button">+ Subtask</button>' : '') + '<div class="meta"><span class="badge project">' + esc(task.project) + '</span><span class="badge key">' + esc(task.key) + '</span><span class="badge kind">' + kind.emoji + ' ' + esc(task.kind) + '</span><span class="badge priority">' + priority.emoji + ' ' + esc(task.priority) + '</span><span class="badge assignee">' + assignee + ' ' + esc(task.assignee) + '</span>' + (relationCount ? '<span class="badge link">⛓ ' + relationCount + '</span>' : '') + '</div><h3>' + esc(task.title) + '</h3><div class="foot"><span>' + esc(task.parent ? 'child of ' + task.parent : 'top-level') + '</span><span>' + esc(titleStatus(task.status)) + '</span></div></article>'; }
    function openTaskDetail(key) { const drawer = document.getElementById('drawer'); if (drawer.classList.contains('open') && currentDetailKey === key && !drawer.classList.contains('loading')) { closeDrawer(); return; } currentDetailKey = key; const task = state.tasks.find(t => t.key === key); if (task) renderDrawer(task, '<p>Loading description…</p>', true); window.glimpse.send({ type: 'showTaskDetail', key }); }
    function installLaneToggles() { document.querySelectorAll('[data-toggle-lane]').forEach(button => button.addEventListener('click', event => { event.stopPropagation(); const key = button.dataset.toggleLane; if (!key) return; const collapsedLanes = activeCollapsedLanes(); if (collapsedLanes.has(key)) collapsedLanes.delete(key); else collapsedLanes.add(key); render(); })); }
    function installDragHandlers() { document.querySelectorAll('.drag-strip').forEach(handle => { handle.addEventListener('click', event => event.stopPropagation()); handle.addEventListener('dragstart', event => { const card = handle.closest('.card'); event.dataTransfer.setData('text/plain', handle.dataset.key); event.dataTransfer.effectAllowed = 'move'; if (card) { const rect = card.getBoundingClientRect(); event.dataTransfer.setDragImage(card, Math.min(24, rect.width / 2), Math.min(24, rect.height / 2)); card.classList.add('dragging'); } }); handle.addEventListener('dragend', () => handle.closest('.card')?.classList.remove('dragging')); }); document.querySelectorAll('.card').forEach(card => { card.addEventListener('click', event => { if (event.target.closest('button') || event.target.closest('.drag-strip')) return; openTaskDetail(card.dataset.key); }); }); document.querySelectorAll('[data-detail-key]').forEach(button => button.addEventListener('click', event => { event.stopPropagation(); openTaskDetail(button.dataset.detailKey); })); document.querySelectorAll('[data-add-subtask]').forEach(button => button.addEventListener('click', event => { event.stopPropagation(); openNewTaskModal({ kind: 'SUBTASK', parent: button.dataset.addSubtask }); })); document.querySelectorAll('.cards').forEach(zone => { zone.addEventListener('dragover', event => { event.preventDefault(); event.dataTransfer.dropEffect = 'move'; zone.classList.add('drag-over'); }); zone.addEventListener('dragleave', () => zone.classList.remove('drag-over')); zone.addEventListener('drop', event => { event.preventDefault(); zone.classList.remove('drag-over'); const key = event.dataTransfer.getData('text/plain'); const status = zone.dataset.status; if (key && status) window.glimpse.send({ type: 'updateStatus', key, status }); }); }); }
    function badges(task) { const priority = priorityInfo[task.priority] || priorityInfo.LOW; const kind = kindInfo[task.kind] || kindInfo.TASK; const assignee = assigneeEmoji[task.assignee] || '○'; return '<div class="meta" style="--priority-color:' + priority.color + '; --kind-color:' + kind.color + '"><span class="badge project">' + esc(task.project) + '</span><span class="badge key">' + esc(task.key) + '</span><span class="badge kind">' + kind.emoji + ' ' + esc(task.kind) + '</span><span class="badge priority">' + priority.emoji + ' ' + esc(task.priority) + '</span><span class="badge assignee">' + assignee + ' ' + esc(task.assignee) + '</span><span class="badge link">' + esc(titleStatus(task.status)) + '</span></div>'; }
    function actionMenuHTML(task) { const addSubtask = task.kind !== 'SUBTASK' ? '<button data-action="addSubtask">+ Add subtask</button>' : ''; return '<div class="action-menu-wrap"><button data-action-toggle type="button">Quick actions ▾</button><div class="action-menu"><button data-action="pickup">Pickup</button><button data-action="assign" data-assignee="AGENT">Assign AGENT</button><button data-action="assign" data-assignee="USER">Assign USER</button><button data-action="assign" data-assignee="UNASSIGNED">Unassign</button><button data-action="status" data-status="NOT STARTED">Move to not started</button><button data-action="status" data-status="IN PROGRESS">Move to in progress</button><button data-action="completeNeedsReview">Move to needs review</button>' + addSubtask + '<button class="success-button" data-action="completeFinal" data-resolution="DONE">Complete DONE</button><button class="danger-button" data-action="completeFinal" data-resolution="WONTFIX">Complete WONTFIX</button></div></div>'; }
    function setupDrawerResize(drawer) { const sash = drawer.querySelector('.drawer-sash'); if (!sash) return; sash.addEventListener('mousedown', event => { event.preventDefault(); const startX = event.clientX; const startWidth = drawer.getBoundingClientRect().width; const onMove = move => { const width = Math.max(380, Math.min(window.innerWidth * 0.88, startWidth + (startX - move.clientX))); drawer.style.width = width + 'px'; }; const onUp = () => { window.removeEventListener('mousemove', onMove); window.removeEventListener('mouseup', onUp); }; window.addEventListener('mousemove', onMove); window.addEventListener('mouseup', onUp); }); }
    function renderDrawer(task, bodyHtml, loading = false) { const drawer = document.getElementById('drawer'); drawer.innerHTML = '<div class="drawer-sash" title="Drag to resize"></div><div class="drawer-head"><div><h2>' + esc(task.title) + '</h2></div><button data-close-drawer>Close</button></div>' + badges(task) + '<div class="section"><h3>Quick actions</h3><div class="actions">' + actionMenuHTML(task) + '</div></div><div class="section"><h3>Relationships</h3>' + relationshipHTML(task) + '</div><div class="section"><h3>Description preview</h3><div class="body-preview markdown">' + bodyHtml + '</div></div><div class="section"><h3>Timestamps</h3><p>Created: ' + esc(task.createdAt || 'unknown') + '<br/>Updated: ' + esc(task.updatedAt || 'unknown') + '<br/>Reporter: ' + esc(task.reporter) + '</p></div>'; setupDrawerResize(drawer); drawer.querySelector('[data-close-drawer]').addEventListener('click', closeDrawer); const menu = drawer.querySelector('.action-menu'); drawer.querySelector('[data-action-toggle]').addEventListener('click', event => { event.stopPropagation(); menu.classList.toggle('open'); }); drawer.querySelectorAll('[data-action]').forEach(button => button.addEventListener('click', () => { const action = button.dataset.action; menu?.classList.remove('open'); if (action === 'assign') taskAction('assign', { assignee: button.dataset.assignee }); else if (action === 'status') taskAction('status', { status: button.dataset.status }); else if (action === 'completeFinal') completeFinal(button.dataset.resolution); else if (action === 'addSubtask') openNewTaskModal({ kind: 'SUBTASK', parent: task.key }); else taskAction(action); })); drawer.querySelectorAll('[data-rel-key]').forEach(link => link.addEventListener('click', event => { event.preventDefault(); openLinkedTask(link.dataset.relKey); })); drawer.classList.toggle('loading', loading); drawer.classList.add('open'); }
    function showDetail(payload) { const task = payload.detail.metadata || state.tasks.find(t => t.key === payload.key); if (!task) return; currentDetailKey = task.key; highlighted = new Set([task.key].concat(task.parent ? [task.parent] : [], task.dependsOn || [], task.blockedBy || [], task.related || [], state.tasks.filter(t => t.parent === task.key).map(t => t.key))); render(); renderDrawer(task, payload.detail.bodyHtml || renderMarkdown(payload.detail.body || 'No description.'), false); }
    function relationshipHTML(task) { const link = key => '<a href="#" class="relationship-link" data-rel-key="' + esc(key) + '">' + esc(key) + '</a>'; const rows = []; if (task.parent) rows.push('<strong>Parent:</strong> ' + link(task.parent)); if (task.dependsOn?.length) rows.push('<strong>Depends on:</strong> ' + task.dependsOn.map(link).join(' ')); if (task.blockedBy?.length) rows.push('<strong>Blocked by:</strong> ' + task.blockedBy.map(link).join(' ')); if (task.related?.length) rows.push('<strong>Related:</strong> ' + task.related.map(link).join(' ')); const children = state.tasks.filter(t => t.parent === task.key).map(t => t.key); if (children.length) rows.push('<strong>Children:</strong> ' + children.map(link).join(' ')); return rows.length ? '<p>' + rows.join('<br/>') + '</p>' : '<p style="color:#a1a1aa">No relationships.</p>'; }
    window.showDetail = showDetail;
    function closeDrawer() { document.getElementById('drawer').classList.remove('open'); highlighted = new Set(); render(); }
    window.closeDrawer = closeDrawer;
    window.taskAction = (action, extra = {}) => { if (!currentDetailKey) return; window.glimpse.send({ type: 'taskAction', action, key: currentDetailKey, ...extra }); };
    window.completeFinal = (resolution) => { const key = currentDetailKey; const modal = document.getElementById('modal'); modal.innerHTML = '<div class="drawer-head"><h2>Complete ' + esc(key) + '</h2><button data-cancel-complete>Close</button></div><p>Complete this task with resolution <strong>' + esc(resolution) + '</strong>?</p><div class="actions section"><button class="success-button" data-confirm-complete>Complete ' + esc(resolution) + '</button><button data-cancel-complete>Cancel</button></div>'; document.getElementById('modalBackdrop').classList.add('open'); modal.querySelector('[data-confirm-complete]').addEventListener('click', () => { closeModal(); taskAction('completeFinal', { resolution }); }); modal.querySelectorAll('[data-cancel-complete]').forEach(button => button.addEventListener('click', closeModal)); };
    function findCard(key) { return [...document.querySelectorAll('.card')].find(card => card.dataset.key === key) || null; }
    function clearNarrowFiltersForTask(task) { filters.q = ''; filters.kinds.clear(); filters.priorities.clear(); filters.assignees.clear(); if (task?.project) filters.project = task.project; document.getElementById('search').value = ''; render(); }
    function scrollCardIntoView(key) { requestAnimationFrame(() => { setTimeout(() => { const card = findCard(key); if (!card) return; const rect = card.getBoundingClientRect(); const drawer = document.getElementById('drawer'); const drawerWidth = drawer.classList.contains('open') ? drawer.getBoundingClientRect().width : 0; const visibleWidth = Math.max(320, window.innerWidth - drawerWidth); const targetTop = window.scrollY + rect.top - Math.max(80, (window.innerHeight - rect.height) / 2); const targetLeft = window.scrollX + rect.left - Math.max(24, (visibleWidth - rect.width) / 2); window.scrollTo({ top: Math.max(0, targetTop), left: Math.max(0, targetLeft), behavior: 'smooth' }); card.scrollIntoView({ behavior: 'smooth', block: 'center', inline: 'nearest' }); card.classList.add('highlighted'); setTimeout(() => card.classList.remove('highlighted'), 2200); }, 120); }); }
    function openLinkedTask(key) { const task = state.tasks.find(t => t.key === key); if (!findCard(key) && task?.status !== 'COMPLETE') { pendingScrollKey = key; clearNarrowFiltersForTask(task); } if (!findCard(key) && task?.status === 'COMPLETE') showToast({ message: key + ' is complete and is not shown on the active board', level: 'info' }); pendingScrollKey = key; openTaskDetail(key); scrollCardIntoView(key); }
    function focusKey(key) { openLinkedTask(key); }
    function openRepoModal() { const modal = document.getElementById('modal'); modal.innerHTML = '<div class="drawer-head"><h2>Open repository</h2><button onclick="closeModal()">Close</button></div><p style="color:#a1a1aa">Choose or enter the repository root. Do not choose the <code>.sandpiper/tasks</code> directory.</p><div class="form-grid"><label class="wide">Repository root<div class="input-row"><input id="repoRoot" placeholder="/Users/doug.stephen/git/project" /><button type="button" onclick="browseRepo()">Browse…</button></div></label></div><div class="actions section"><button class="success-button" onclick="submitOpenRepo()">Open repo</button><button onclick="closeModal()">Cancel</button></div>'; document.getElementById('modalBackdrop').classList.add('open'); document.getElementById('repoRoot').focus(); }
    window.browseRepo = () => window.glimpse.send({ type: 'browseRepo' });
    window.submitOpenRepo = () => { const repo = document.getElementById('repoRoot').value.trim(); if (!repo) return showToast({ message: 'Repository root is required', level: 'error' }); window.glimpse.send({ type: 'addRepo', repo }); closeModal(); };
    function openNewTaskModal(prefill = {}) { if (!state.repo) return showToast({ message: 'Open a repo before creating tasks', level: 'error' }); const projects = [...new Set(state.tasks.map(t => t.project))].sort(); const activeParents = state.tasks.filter(t => !t.parent && t.kind !== 'SUBTASK'); const parentTask = prefill.parent ? state.tasks.find(t => t.key === prefill.parent) : null; const modal = document.getElementById('modal'); modal.innerHTML = '<div class="drawer-head"><h2>New task</h2><button onclick="closeModal()">Close</button></div><div class="form-grid"><label>Project<select id="newProject">' + projects.map(p => '<option value="' + esc(p) + '"' + (((prefill.project || parentTask?.project || (filters.project !== 'ALL' ? filters.project : '')) === p) ? ' selected' : '') + '>' + esc(p) + '</option>').join('') + '</select></label><label>Kind<select id="newKind"><option>TASK</option><option>BUG</option><option>SUBTASK</option></select></label><label>Priority<select id="newPriority"><option>HIGH</option><option selected>MEDIUM</option><option>LOW</option></select></label><label>Assignee<select id="newAssignee"><option selected>UNASSIGNED</option><option>AGENT</option><option>USER</option></select></label><label>Reporter<select id="newReporter"><option selected>USER</option><option>AGENT</option></select></label><label>Parent (for SUBTASK)<select id="newParent"><option value="">—</option>' + activeParents.map(t => '<option value="' + esc(t.key) + '"' + (prefill.parent === t.key ? ' selected' : '') + '>' + esc(t.key + ' — ' + t.title) + '</option>').join('') + '</select></label><label class="wide">Title<input id="newTitle" placeholder="Task title" /></label><label class="wide">Description<textarea id="newDesc" placeholder="Optional description; current CLI creates first, then updates description."></textarea></label></div><div class="actions section"><button class="success-button" onclick="submitNewTask()">Create task</button><button onclick="closeModal()">Cancel</button></div>'; if (prefill.kind) document.getElementById('newKind').value = prefill.kind; if (prefill.priority) document.getElementById('newPriority').value = prefill.priority; if (prefill.title) document.getElementById('newTitle').value = prefill.title; document.getElementById('modalBackdrop').classList.add('open'); document.getElementById('newTitle').focus(); }
    function closeModal() { document.getElementById('modalBackdrop').classList.remove('open'); }
    window.closeModal = closeModal;
    window.submitNewTask = () => { const payload = { project: document.getElementById('newProject').value, kind: document.getElementById('newKind').value, priority: document.getElementById('newPriority').value, assignee: document.getElementById('newAssignee').value, reporter: document.getElementById('newReporter').value, parent: document.getElementById('newParent').value, title: document.getElementById('newTitle').value.trim(), description: document.getElementById('newDesc').value }; if (!payload.title) return showToast({ message: 'Title is required', level: 'error' }); if (payload.kind === 'SUBTASK' && !payload.parent) return showToast({ message: 'Subtasks need a parent', level: 'error' }); window.glimpse.send({ type: 'createTask', payload }); closeModal(); };
    window.applyState = (next) => { const repoChanged = state.repo && state.repo !== next.repo; state = next; if (repoChanged || next.tabChanged) { filters = { q: '', project: next.initialProject ?? 'ALL', kinds: new Set(), priorities: new Set(), assignees: new Set() }; document.getElementById('search').value = ''; filtersInitialized = false; highlighted = new Set(); currentDetailKey = null; closeModal(); closeDrawer(); } render(); const updated = new Date(next.updatedAt || Date.now()); document.getElementById('updated').textContent = 'Updated ' + updated.toLocaleTimeString(); if (next.error) showToast({ message: next.error, level: 'error' }); };
    window.showToast = ({ message, level = 'info' }) => { const toast = document.getElementById('toast'); toast.textContent = message; toast.className = 'toast visible ' + level; clearTimeout(toastTimer); toastTimer = setTimeout(() => { toast.className = 'toast ' + level; }, 2600); };
    document.getElementById('search').addEventListener('input', event => { filters.q = event.target.value; render(); });
    document.getElementById('project').addEventListener('change', event => { filters.project = event.target.value; render(); });
    document.getElementById('refresh').addEventListener('click', () => window.glimpse.send({ type: 'refresh' }));
    document.getElementById('openRepo').addEventListener('click', openRepoModal);
    document.getElementById('newTask').addEventListener('click', openNewTaskModal);
    document.getElementById('close').addEventListener('click', () => window.glimpse.close());
    function isEditableElement(element) { if (!element) return false; const tag = element.tagName; return element.isContentEditable || tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT'; }
    document.addEventListener('keydown', event => { const search = document.getElementById('search'); if ((event.metaKey || event.ctrlKey) && event.key.toLowerCase() === 'a' && document.activeElement === search) { event.preventDefault(); search.select(); return; } if (event.key === '/' && !isEditableElement(document.activeElement)) { event.preventDefault(); search.focus(); } if (event.key === 'Escape') { closeModal(); closeDrawer(); } if (event.key === 'r' && (event.metaKey || event.ctrlKey)) { event.preventDefault(); window.glimpse.send({ type: 'refresh' }); } });
  </script>
</body>`;
}

win = open(html(), {
  width: 1360,
  height: 900,
  title: "Live Trail board",
  titlebarStyleOptions: ["unified-compact", "titlebar-transparent"],
});

win.on("ready", () => {
  void refresh();
});

win.on("message", (message) => {
  if (!message || typeof message !== "object") return;
  if (message.type === "refresh") void refresh({ manual: true });
  if (
    message.type === "updateStatus" &&
    typeof message.key === "string" &&
    typeof message.status === "string"
  )
    void updateStatus(message.key, message.status);
  if (message.type === "showTaskDetail" && typeof message.key === "string")
    void showTaskDetail(message.key);
  if (message.type === "taskAction") void runTaskAction(message);
  if (message.type === "createTask") void createTask(message.payload);
  if (message.type === "switchTab" && typeof message.tabId === "string") switchTab(message.tabId);
  if (message.type === "closeTab" && typeof message.tabId === "string") closeTab(message.tabId);
  if (message.type === "reorderTab" && typeof message.tabId === "string")
    reorderTab(message.tabId, typeof message.beforeTabId === "string" ? message.beforeTabId : null);
  if (message.type === "dismissChangeNotice" && typeof message.noticeId === "string")
    dismissChangeNotice(message.noticeId);
  if (message.type === "dismissAllChangeNotices") dismissAllChangeNotices();
  if (message.type === "browseRepo") void browseRepo();
  if (message.type === "addRepo" && typeof message.repo === "string") void addRepo(message.repo);
});

win.on("closed", () => {
  closed = true;
  process.exit(0);
});

const interval = setInterval(() => {
  void refresh();
  void refreshInactiveTabs();
}, POLL_MS);

process.on("SIGTERM", () => {
  clearInterval(interval);
  closed = true;
  try {
    win?.close();
  } catch {}
  process.exit(0);
});

process.on("SIGINT", () => {
  clearInterval(interval);
  closed = true;
  try {
    win?.close();
  } catch {}
  process.exit(0);
});
