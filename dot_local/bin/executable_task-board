#!/usr/bin/env -S mise exec bun -- bun run --bun
import { execFile } from "node:child_process";
import { existsSync, mkdirSync, readFileSync, realpathSync, renameSync, writeFileSync } from "node:fs";
import { homedir } from "node:os";
import { basename, dirname, join, resolve, sep } from "node:path";
import { promisify } from "node:util";

const execFileAsync = promisify(execFile);

// Locate the system-installed glimpseui via mise (version-stamped install path,
// so resolve at runtime rather than baking a stale path). GLIMPSEUI_DIR overrides.
const GLIMPSEUI_DIR =
  process.env.GLIMPSEUI_DIR ??
  join(
    (await execFileAsync("mise", ["where", "npm:glimpseui"])).stdout.trim(),
    "node_modules",
    "glimpseui",
  );
const { open } = await import(join(GLIMPSEUI_DIR, "src", "glimpse.mjs"));

const TASKS =
  process.env.SANDPIPER_TASKS_BIN ??
  "/Users/doug.stephen/git/sandpiper-ai/packages/resources/skills/sandpiper/tasks/scripts/trail";
function normalizeRepoPath(path) {
  const resolved = resolve(path);
  try {
    return realpathSync(resolved);
  } catch {
    return resolved;
  }
}

const INITIAL_REPO = normalizeRepoPath(process.env.SANDPIPER_TASKS_REPO ?? process.cwd());
const INITIAL_PROJECT = process.env.SANDPIPER_TASKS_PROJECT ?? "ALL";
const POLL_MS = 2_500;
const STATE_HOME = process.env.XDG_STATE_HOME
  ? resolve(process.env.XDG_STATE_HOME)
  : join(homedir(), ".local", "state");
const OPEN_REPOS_STATE_PATH = join(STATE_HOME, "sandpiper", "task-board-open-repos.json");
const OPEN_REPOS_STATE_VERSION = 1;

const statuses = [
  { key: "NOT STARTED", title: "Not started", accent: "#64748b" },
  { key: "IN PROGRESS", title: "In progress", accent: "#3b82f6" },
  { key: "NEEDS REVIEW", title: "Needs review", accent: "#f59e0b" },
];

const priorityRank = { HIGH: 0, MEDIUM: 1, LOW: 2 };
const kindRank = { BUG: 0, TASK: 1, SUBTASK: 2 };

function normalizeRepoList(repos) {
  const seen = new Set();
  const normalized = [];
  for (const raw of Array.isArray(repos) ? repos : []) {
    if (typeof raw !== "string" || !raw.trim()) continue;
    const repo = normalizeRepoPath(raw.trim());
    if (seen.has(repo)) continue;
    seen.add(repo);
    normalized.push(repo);
  }
  return normalized;
}

function hasTaskDirectory(repo) {
  return existsSync(join(repo, ".sandpiper", "tasks"));
}

function openReposStateExists() {
  return existsSync(OPEN_REPOS_STATE_PATH);
}

function readOpenReposState() {
  try {
    if (!openReposStateExists()) return [];
    const parsed = JSON.parse(readFileSync(OPEN_REPOS_STATE_PATH, "utf8"));
    return normalizeRepoList(parsed.repos);
  } catch (error) {
    console.error(
      "Could not read task board open repos state",
      error instanceof Error ? error.message : String(error),
    );
    return [];
  }
}

function initialRepoList() {
  const savedRepos = openReposStateExists() ? readOpenReposState() : [];
  return hasTaskDirectory(INITIAL_REPO) ? normalizeRepoList([...savedRepos, INITIAL_REPO]) : savedRepos;
}

function persistOpenRepos() {
  try {
    mkdirSync(dirname(OPEN_REPOS_STATE_PATH), { recursive: true });
    const payload = JSON.stringify(
      {
        version: OPEN_REPOS_STATE_VERSION,
        repos: normalizeRepoList(tabs.map((tab) => tab.repo)),
      },
      null,
      2,
    );
    const tempPath = `${OPEN_REPOS_STATE_PATH}.${process.pid}.tmp`;
    writeFileSync(tempPath, `${payload}\n`);
    renameSync(tempPath, OPEN_REPOS_STATE_PATH);
  } catch (error) {
    console.error(
      "Could not write task board open repos state",
      error instanceof Error ? error.message : String(error),
    );
  }
}

let win;
let lastTasks = [];
let loading = false;
let closed = false;
let nextTabNumber = 1;
let nextChangeNoticeNumber = 1;
const initialRepos = initialRepoList();
let tabs = initialRepos.map((repo) =>
  createRepoTab(repo, repo === INITIAL_REPO ? INITIAL_PROJECT : "ALL"),
);
let activeTabId =
  (hasTaskDirectory(INITIAL_REPO) && tabs.find((tab) => tab.repo === INITIAL_REPO)?.id) ||
  tabs[0]?.id ||
  null;

if (tabs.length === 0) persistOpenRepos();

function repoLabel(repo) {
  return basename(repo) || repo;
}

function createRepoTab(repo, initialProject = "ALL") {
  return {
    id: `repo-${nextTabNumber++}`,
    repo,
    label: repoLabel(repo),
    initialProject,
    tasks: [],
    snapshot: null,
    changed: false,
    changeNotices: [],
    updatedAt: null,
    error: null,
  };
}

function activeTab() {
  return tabs.find((tab) => tab.id === activeTabId) ?? tabs[0] ?? null;
}

function tabSummaries() {
  return tabs.map((tab) => ({
    id: tab.id,
    label: tab.label,
    repo: tab.repo,
    active: tab.id === activeTabId,
    changed: tab.changed,
    count: tab.tasks.filter((task) => task.status !== "COMPLETE").length,
    error: tab.error,
  }));
}

function assertRepoRoot(repo) {
  if (repo.endsWith(`${sep}.sandpiper${sep}tasks`)) {
    throw new Error("Open the repository root, not the .sandpiper/tasks directory.");
  }
}

function execTasks(args, repo = activeTab()?.repo) {
  if (!repo) throw new Error("Open a repository before running task commands.");
  return execFileAsync(TASKS, args, {
    cwd: repo,
    maxBuffer: 30 * 1024 * 1024,
    env: process.env,
  });
}

function asArray(value) {
  return Array.isArray(value) ? value : [];
}

function normalizeTask(task) {
  return {
    key: task.key,
    project: task.project ?? String(task.key ?? "").split("-")[0] ?? "UNKNOWN",
    title: task.title ?? "(untitled)",
    status: task.status ?? "NOT STARTED",
    kind: task.kind ?? "TASK",
    priority: task.priority ?? "LOW",
    assignee: task.assignee ?? "UNASSIGNED",
    reporter: task.reporter ?? "UNKNOWN",
    parent: task.parent ?? null,
    dependsOn: asArray(task.dependsOn ?? task.depends_on),
    blockedBy: asArray(task.blockedBy ?? task.blocked_by),
    related: asArray(task.related),
    updatedAt: task.updatedAt ?? task.updated_at ?? null,
    createdAt: task.createdAt ?? task.created_at ?? null,
    resolution: task.resolution ?? null,
  };
}

async function readTasks(repo = activeTab()?.repo) {
  const { stdout } = await execTasks(["--format", "json", "task", "list"], repo);
  return JSON.parse(stdout)
    .map(normalizeTask)
    .sort((a, b) => {
      const project = a.project.localeCompare(b.project);
      if (project !== 0) return project;
      const priority = (priorityRank[a.priority] ?? 9) - (priorityRank[b.priority] ?? 9);
      if (priority !== 0) return priority;
      const kind = (kindRank[a.kind] ?? 9) - (kindRank[b.kind] ?? 9);
      if (kind !== 0) return kind;
      return a.key.localeCompare(b.key, undefined, { numeric: true });
    });
}

function taskSnapshot(tasks) {
  return JSON.stringify(
    tasks.map((task) => [
      task.key,
      task.title,
      task.status,
      task.kind,
      task.priority,
      task.assignee,
      task.parent,
      task.updatedAt,
      task.resolution,
      task.dependsOn,
      task.blockedBy,
      task.related,
    ]),
  );
}

function taskLabel(task) {
  return `${task.key}: ${task.title}`;
}

function arrayChanged(a, b) {
  return JSON.stringify(a ?? []) !== JSON.stringify(b ?? []);
}

function buildChangeNotice(beforeTasks, afterTasks) {
  const before = new Map(beforeTasks.map((task) => [task.key, task]));
  const after = new Map(afterTasks.map((task) => [task.key, task]));
  const details = [];

  for (const task of afterTasks) {
    if (!before.has(task.key)) details.push(`Added ${taskLabel(task)}`);
  }
  for (const task of beforeTasks) {
    if (!after.has(task.key)) details.push(`Removed ${taskLabel(task)}`);
  }
  for (const task of afterTasks) {
    const previous = before.get(task.key);
    if (!previous) continue;
    const detailCountBeforeTask = details.length;
    if (previous.status !== task.status)
      details.push(`${task.key}: status ${previous.status} → ${task.status}`);
    if (previous.assignee !== task.assignee)
      details.push(`${task.key}: assignee ${previous.assignee} → ${task.assignee}`);
    if (previous.priority !== task.priority)
      details.push(`${task.key}: priority ${previous.priority} → ${task.priority}`);
    if (previous.title !== task.title) details.push(`${task.key}: title changed`);
    if (previous.resolution !== task.resolution)
      details.push(`${task.key}: resolution ${previous.resolution ?? "—"} → ${task.resolution ?? "—"}`);
    if (
      arrayChanged(previous.dependsOn, task.dependsOn) ||
      arrayChanged(previous.blockedBy, task.blockedBy) ||
      arrayChanged(previous.related, task.related)
    )
      details.push(`${task.key}: relationships changed`);
    if (details.length === detailCountBeforeTask && previous.updatedAt !== task.updatedAt)
      details.push(`${task.key}: metadata updated`);
  }

  const shownDetails = details.slice(0, 8);
  const hiddenCount = Math.max(0, details.length - shownDetails.length);
  return {
    id: `change-${nextChangeNoticeNumber++}`,
    createdAt: new Date().toISOString(),
    summary: `${details.length || 1} task change${details.length === 1 ? "" : "s"} while this tab was inactive`,
    details: shownDetails.length ? shownDetails : ["Task metadata changed"],
    hiddenCount,
  };
}

function setTabTasks(tab, tasks, { markChanged = false } = {}) {
  const nextSnapshot = taskSnapshot(tasks);
  const changed = tab.snapshot !== null && tab.snapshot !== nextSnapshot;
  if (markChanged && changed) {
    tab.changed = true;
    tab.changeNotices.push(buildChangeNotice(tab.tasks, tasks));
  }
  tab.tasks = tasks;
  tab.snapshot = nextSnapshot;
  tab.updatedAt = new Date().toISOString();
  tab.error = null;
}

function parseBody(raw) {
  const withoutFrontmatter = raw.replace(/^---\n[\s\S]*?\n---\n?/, "").trim();
  return withoutFrontmatter.split("\n---\n\n# Activity Log")[0].trim();
}

function escapeHtml(value) {
  return String(value)
    .replaceAll("&", "&amp;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;")
    .replaceAll('"', "&quot;");
}

function inlineMarkdownHtml(value) {
  return escapeHtml(value)
    .replace(/`([^`]+)`/g, "<code>$1</code>")
    .replace(/\*\*([^*]+)\*\*/g, "<strong>$1</strong>")
    .replace(/\[([^\]]+)\]\((https?:[^)]+)\)/g, '<a href="$2">$1</a>');
}

function markdownToHtml(markdown) {
  const lines = String(markdown || "")
    .replaceAll("\r\n", "\n")
    .split("\n");
  let html = "";
  let inCode = false;
  let inList = false;
  for (const raw of lines) {
    const line = raw.endsWith("\r") ? raw.slice(0, -1) : raw;
    if (line.startsWith("```")) {
      if (inList) {
        html += "</ul>";
        inList = false;
      }
      if (inCode) {
        html += "</code></pre>";
        inCode = false;
      } else {
        html += "<pre><code>";
        inCode = true;
      }
      continue;
    }
    if (inCode) {
      html += escapeHtml(line) + "\n";
      continue;
    }
    if (!line.trim()) {
      if (inList) {
        html += "</ul>";
        inList = false;
      }
      continue;
    }
    if (line.startsWith("### ")) {
      if (inList) {
        html += "</ul>";
        inList = false;
      }
      html += "<h3>" + inlineMarkdownHtml(line.slice(4)) + "</h3>";
      continue;
    }
    if (line.startsWith("## ")) {
      if (inList) {
        html += "</ul>";
        inList = false;
      }
      html += "<h2>" + inlineMarkdownHtml(line.slice(3)) + "</h2>";
      continue;
    }
    if (line.startsWith("# ")) {
      if (inList) {
        html += "</ul>";
        inList = false;
      }
      html += "<h1>" + inlineMarkdownHtml(line.slice(2)) + "</h1>";
      continue;
    }
    if (line.startsWith("> ")) {
      if (inList) {
        html += "</ul>";
        inList = false;
      }
      html += "<blockquote>" + inlineMarkdownHtml(line.slice(2)) + "</blockquote>";
      continue;
    }
    if (line.startsWith("- ") || line.startsWith("* ")) {
      if (!inList) {
        html += "<ul>";
        inList = true;
      }
      html += "<li>" + inlineMarkdownHtml(line.slice(2)) + "</li>";
      continue;
    }
    if (inList) {
      html += "</ul>";
      inList = false;
    }
    html += "<p>" + inlineMarkdownHtml(line) + "</p>";
  }
  if (inList) html += "</ul>";
  if (inCode) html += "</code></pre>";
  return html || "<p>No description.</p>";
}

function sendState(extra = {}) {
  if (!win || closed) return;
  const tab = activeTab();
  lastTasks = tab?.tasks ?? [];
  const payload = JSON.stringify({
    type: "state",
    tasks: tab?.tasks ?? [],
    statuses,
    initialProject: tab?.initialProject ?? "ALL",
    repo: tab?.repo ?? "",
    tabs: tabSummaries(),
    changeNotices: tab?.changeNotices ?? [],
    updatedAt: tab?.updatedAt ?? new Date().toISOString(),
    ...extra,
  });
  win.send(`window.applyState(${payload})`);
}

function sendToast(message, level = "info") {
  if (!win || closed) return;
  win.send(`window.showToast(${JSON.stringify({ message, level })})`);
}

function sendDetail(key, detail) {
  if (!win || closed) return;
  win.send(`window.showDetail(${JSON.stringify({ key, detail })})`);
}

async function refresh(extra = {}) {
  if (loading || closed) return;
  const tab = activeTab();
  if (!tab) {
    lastTasks = [];
    sendState(extra);
    return;
  }

  loading = true;
  try {
    setTabTasks(tab, await readTasks(tab.repo));
    lastTasks = tab.tasks;
    persistOpenRepos();
    sendState(extra);
  } catch (error) {
    const message = error instanceof Error ? error.message : String(error);
    tab.error = message;
    sendToast(message, "error");
    sendState({ error: message });
  } finally {
    loading = false;
  }
}

async function showTaskDetail(key) {
  const metadata = lastTasks.find((task) => task.key === key) ?? null;
  try {
    const { stdout } = await execTasks(["--format", "raw", "task", "show", key]);
    {
      const body = parseBody(stdout);
      sendDetail(key, { metadata, body, bodyHtml: markdownToHtml(body), error: null });
    }
  } catch (error) {
    {
      const message = error instanceof Error ? error.message : String(error);
      console.error("task detail failed", key, message);
      sendDetail(key, {
        metadata,
        body: null,
        bodyHtml:
          "<p>Could not load body via task show:</p><pre><code>" +
          escapeHtml(message) +
          "</code></pre>",
        error: message,
      });
    }
  }
}

async function updateStatus(key, status) {
  const task = lastTasks.find((candidate) => candidate.key === key);
  if (!task) {
    sendToast(`Task ${key} is no longer visible`, "error");
    await refresh();
    return;
  }
  if (task.status === status) return;
  if (!statuses.some((candidate) => candidate.key === status)) {
    sendToast(`Unsupported status: ${status}`, "error");
    return;
  }

  const tab = activeTab();
  if (!tab) {
    sendToast("Open a repository before updating tasks", "error");
    return;
  }

  tab.tasks = tab.tasks.map((candidate) =>
    candidate.key === key ? { ...candidate, status } : candidate,
  );
  lastTasks = tab.tasks;
  sendState({ pending: { key, status } });

  try {
    await execTasks(["task", "update", key, "--status", status]);
    sendToast(`${key} → ${status.toLowerCase()}`, "success");
  } catch (error) {
    sendToast(error instanceof Error ? error.message : String(error), "error");
  } finally {
    await refresh();
  }
}

async function runTaskAction(message) {
  try {
    if (message.action === "assign") {
      await execTasks(["task", "update", message.key, "--assignee", message.assignee]);
      sendToast(`${message.key} assigned to ${message.assignee}`, "success");
    } else if (message.action === "pickup") {
      await execTasks(["task", "pickup", message.key]);
      sendToast(`${message.key} picked up`, "success");
    } else if (message.action === "status") {
      await updateStatus(message.key, message.status);
      return;
    } else if (message.action === "completeNeedsReview") {
      await execTasks(["task", "complete", message.key]);
      sendToast(`${message.key} moved to needs review`, "success");
    } else if (message.action === "completeFinal") {
      await execTasks([
        "task",
        "complete",
        message.key,
        "--final",
        "--resolution",
        message.resolution,
      ]);
      sendToast(`${message.key} completed (${message.resolution})`, "success");
    }
    await refresh();
    if (message.key) void showTaskDetail(message.key);
  } catch (error) {
    sendToast(error instanceof Error ? error.message : String(error), "error");
    await refresh();
  }
}

async function createTask(payload) {
  try {
    const args = [
      "task",
      "create",
      "-p",
      payload.project,
      "-t",
      payload.title,
      "-k",
      payload.kind,
      "--priority",
      payload.priority,
      "--reporter",
      payload.reporter,
    ];
    if (payload.kind === "SUBTASK" && payload.parent) args.push("--parent", payload.parent);
    const { stdout } = await execTasks(args);
    const key = stdout.match(/[A-Z]+-[0-9]+/)?.[0];
    if (!key) throw new Error(`Created task but could not parse key from: ${stdout}`);
    if (payload.description?.trim()) {
      await execTasks(["task", "update", key, "--desc", payload.description.trim()]);
    }
    if (payload.assignee && payload.assignee !== "UNASSIGNED") {
      await execTasks(["task", "update", key, "--assignee", payload.assignee]);
    }
    sendToast(`Created ${key}`, "success");
    await refresh();
    void showTaskDetail(key);
  } catch (error) {
    sendToast(error instanceof Error ? error.message : String(error), "error");
    await refresh();
  }
}

function switchTab(tabId) {
  const tab = tabs.find((candidate) => candidate.id === tabId);
  if (!tab) return;
  activeTabId = tab.id;
  tab.changed = false;
  lastTasks = tab.tasks;
  sendState({ tabChanged: true });
  void refresh({ tabChanged: true });
}

function reorderTab(tabId, beforeTabId) {
  if (tabId === beforeTabId) return;
  const from = tabs.findIndex((candidate) => candidate.id === tabId);
  if (from < 0) return;
  const [tab] = tabs.splice(from, 1);
  const to = beforeTabId
    ? tabs.findIndex((candidate) => candidate.id === beforeTabId)
    : tabs.length;
  tabs.splice(to < 0 ? tabs.length : to, 0, tab);
  persistOpenRepos();
  sendState({ tabChanged: true });
}

function dismissChangeNotice(noticeId) {
  const tab = activeTab();
  if (!tab) return;
  tab.changeNotices = tab.changeNotices.filter((notice) => notice.id !== noticeId);
  sendState();
}

function dismissAllChangeNotices() {
  const tab = activeTab();
  if (!tab || tab.changeNotices.length === 0) return;
  tab.changeNotices = [];
  tab.changed = false;
  sendState();
}

async function refreshInactiveTabs() {
  for (const tab of tabs) {
    if (tab.id === activeTabId) continue;
    try {
      setTabTasks(tab, await readTasks(tab.repo), { markChanged: true });
    } catch (error) {
      const message = error instanceof Error ? error.message : String(error);
      tab.error = message;
    }
  }
  sendState();
}

function closeTab(tabId) {
  const index = tabs.findIndex((candidate) => candidate.id === tabId);
  if (index < 0) return;
  const wasActive = tabs[index].id === activeTabId;
  tabs.splice(index, 1);
  if (wasActive) activeTabId = tabs[Math.max(0, index - 1)]?.id ?? tabs[0]?.id ?? null;
  persistOpenRepos();
  lastTasks = activeTab()?.tasks ?? [];
  sendState({ tabChanged: true });
  if (tabs.length) void refresh({ tabChanged: true });
}

async function addRepo(repoInput) {
  try {
    const repo = normalizeRepoPath(String(repoInput ?? "").trim());
    assertRepoRoot(repo);
    const existing = tabs.find((tab) => tab.repo === repo);
    if (existing) {
      activeTabId = existing.id;
      switchTab(existing.id);
      return true;
    }

    const tasks = await readTasks(repo);
    const tab = createRepoTab(repo, "ALL");
    setTabTasks(tab, tasks);
    tabs.push(tab);
    activeTabId = tab.id;
    lastTasks = tasks;
    persistOpenRepos();
    sendToast(`Opened ${repo}`, "success");
    sendState({ tabChanged: true });
    return true;
  } catch (error) {
    sendToast(error instanceof Error ? error.message : String(error), "error");
    return false;
  }
}

async function browseRepo() {
  try {
    const paths = await win.pickDirectory({ title: "Choose a repository root" });
    const repo = paths?.[0];
    if (!repo) return;

    win.send(
      `(() => { const input = document.getElementById('repoRoot'); if (input) input.value = ${JSON.stringify(repo)}; })()`,
    );
    if (await addRepo(repo)) win.send("window.closeModal?.()");
  } catch (error) {
    sendToast(error instanceof Error ? error.message : String(error), "error");
  }
}

function html() {
  return `
<body>
  <style>
    :root { color-scheme: dark; }
    * { box-sizing: border-box; }
    body {
      margin: 0;
      min-height: 100vh;
      font-family: Avenir Next, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, sans-serif;
      background: radial-gradient(circle at 14% 4%, rgba(245,158,11,.12), transparent 24%), radial-gradient(circle at 85% 0%, rgba(59,130,246,.18), transparent 28%), linear-gradient(135deg, #10131c 0%, #151827 56%, #101014 100%);
      color: #e5e7eb;
      padding: 48px 18px 18px;
    }
    .topbar { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 12px; }
    .repo-tabs { display: flex; gap: 8px; align-items: center; margin: 0 0 12px; overflow-x: auto; padding-bottom: 2px; }
    .repo-tab { display: flex; align-items: center; gap: 8px; max-width: 320px; border-radius: 14px; padding: 7px 9px; background: rgba(255,255,255,.055); border: 1px solid rgba(255,255,255,.12); color: #cbd5e1; }
    .repo-tab.dragging { opacity: .45; }
    .repo-tab.drop-before { box-shadow: -3px 0 0 #60a5fa; }
    .repo-tab.active { color: white; border-color: rgba(96,165,250,.54); background: linear-gradient(135deg, rgba(59,130,246,.30), rgba(14,165,233,.12)); }
    .repo-tab.changed:not(.active) { color: white; border-color: rgba(245,158,11,.62); background: linear-gradient(135deg, rgba(245,158,11,.26), rgba(59,130,246,.10)); }
    .repo-tab.error { border-color: rgba(239,68,68,.45); }
    .repo-tab .tab-main { display: flex; align-items: center; gap: 8px; min-width: 0; border: 0; background: transparent; color: inherit; padding: 2px 0; backdrop-filter: none; }
    .repo-tab .tab-label { overflow: hidden; text-overflow: ellipsis; white-space: nowrap; }
