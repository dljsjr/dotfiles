#!/usr/bin/env sh

set_args=''
needle="--with-claude"

for arg in "$@"; do
    if [ "$arg" != "$needle" ]; then
        set_args="${set_args:+${set_args} }'$(printf "%s" "$arg" | sed "s/'/'\\\\''/g")'"
    else
        mkdir -p "$HOME/.sandpiper/agent/claude-provider/trace-logs"
        logfile_name="$(date -ju +'%Y%m%d_%H%M%S')_pccp.log"
        touch "$logfile_name"
        export PCCP_TRACE_LEVEL=trace
        export PCCP_TRACE_PATH="$logfile_name"
        set_args="${set_args} --claude-remote-control --preserve-claude-tools 'WebSearch,LSP,NotebookEdit'"
    fi
done

eval "set -- $set_args"

if [ "$(basename "$0")" = "@sandpiper" ]; then
    printf "running in development mode\n\n" >&2
    mise exec bun -- bun --workspaces --cwd=$HOME/git/sandpiper-ai install --recursive
    exec mise exec bun -- bun run --bun $HOME/git/sandpiper-ai/packages/cli/sandpiper_standalone.ts -- "$@" "$extra_args"
fi

exec mise exec bun -- bun run --bun $HOME/git/sandpiper-ai/node_modules/.bin/sandpiper "$@" "$extra_args"
