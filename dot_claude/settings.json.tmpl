{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "PI_CODING_AGENT_DIR": "~/.sandpiper/agent"
  },
  "includeGitInstructions": false,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "opus[1m]",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{- .chezmoi.homeDir -}}/.claude/hooks/bootstrap.py"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{- .chezmoi.homeDir -}}/.claude/hooks/block-rg-dash-r.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{- .chezmoi.homeDir -}}/.claude/hooks/inject-local-time.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{- .chezmoi.homeDir -}}/.claude/hooks/tracker-keys-in-comments.py 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "{{- .chezmoi.homeDir -}}/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "duckdb-skills@duckdb-skills": true,
    "astral@astral-sh": true,
    "frontend-design@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "tui-art@dljsjr": true
  },
  "extraKnownMarketplaces": {
    "duckdb-skills": {
      "source": {
        "source": "github",
        "repo": "duckdb/duckdb-skills"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "dljsjr": {
      "source": {
        "source": "github",
        "repo": "dljsjr/tui-art"
      }
    }
  },
  "outputStyle": "Concise",
  "viewMode": "focus",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "xhigh",
  "tui": "fullscreen",
  "showThinkingSummaries": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "display": "summarized",
  "thinkingDisplay": "summarized"
}
