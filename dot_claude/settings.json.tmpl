{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "syncClaudeAiSkills": false,
  "syncClaudeAiPlugins": false,
  "env": {
    "AGENT_JOURNAL_DIR": ".sandpiper",
    "CLAUDE_CODE_EXPERIMENTAL_AGENT_TEAMS": "1",
    "CLAUDE_CODE_NO_FLICKER": "1",
    "CLAUDE_CODE_THRIFTY_SONIC": "0",
    "PI_CODING_AGENT_DIR": "~/.sandpiper/agent"
  },
  "attribution": {
    "commit": "",
    "pr": "",
    "sessionUrl": false
  },
  "includeGitInstructions": false,
  "permissions": {
    "defaultMode": "bypassPermissions"
  },
  "model": "claude-opus-5-5[1m]",
  "skillOverrides": {
    "jj": "off"
  },
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume",
        "hooks": [
          {
            "type": "command",
            "command": "{{- .chezmoi.homeDir -}}/.claude/hooks/bootstrap.py"
          }
        ]
      },
      {
        "matcher": "^(startup|resume|clear|compact|fork)$",
        "hooks": [
          {
            "type": "command",
            "command": "bash '{{- .chezmoi.homeDir -}}/.claude/hooks/herdr-agent-state.sh' session",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "{{- .chezmoi.homeDir -}}/.claude/hooks/block-rg-dash-r.py"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "{{- .chezmoi.homeDir -}}/.claude/hooks/inject-local-time.sh"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "Write|Edit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "{{- .chezmoi.homeDir -}}/.claude/hooks/tracker-keys-in-comments.py 2>/dev/null || true"
          }
        ]
      }
    ]
  },
  "enableArtifact": true,
  "statusLine": {
    "type": "command",
    "command": "{{- .chezmoi.homeDir -}}/.claude/statusline.sh",
    "padding": 0,
    "refreshInterval": 30
  },
  "enabledPlugins": {
    "rust-analyzer-lsp@claude-plugins-official": true,
    "duckdb-skills@duckdb-skills": true,
    "astral@astral-sh": true,
    "frontend-design@claude-plugins-official": true,
    "php-lsp@claude-plugins-official": true,
    "code-simplifier@claude-plugins-official": true,
    "skill-creator@claude-plugins-official": true,
    "i-have-adhd@i-have-adhd": true,
    "tui-art@dljsjr": true,
    "obsidian@obsidian-skills": true,
    "cc-plugin-you-should-know@builtin": true,
    "cc-plugin-diff@builtin": true,
    "agent-journal@agent-journal": true,
    "jujutsu-vcs@jujutsu-vcs-skill": true,
    "tattler@claude-tattler": true
  },
  "extraKnownMarketplaces": {
    "duckdb-skills": {
      "source": {
        "source": "github",
        "repo": "duckdb/duckdb-skills"
      }
    },
    "astral-sh": {
      "source": {
        "source": "github",
        "repo": "astral-sh/claude-code-plugins"
      }
    },
    "i-have-adhd": {
      "source": {
        "source": "github",
        "repo": "ayghri/i-have-adhd"
      }
    },
    "dljsjr": {
      "source": {
        "source": "github",
        "repo": "dljsjr/tui-art"
      }
    },
    "obsidian-skills": {
      "source": {
        "source": "github",
        "repo": "kepano/obsidian-skills"
      }
    },
    "agent-journal": {
      "source": {
        "source": "github",
        "repo": "dljsjr/agent-journal"
      }
    },
    "jujutsu-vcs-skill": {
      "source": {
        "source": "github",
        "repo": "dljsjr/jujutsu-vcs-skill"
      }
    },
    "claude-tattler": {
      "source": {
        "source": "github",
        "repo": "dljsjr/claude-tattler"
      }
    }
  },
  "outputStyle": "Concise",
  "viewMode": "focus",
  "syntaxHighlightingDisabled": false,
  "effortLevel": "xhigh",
  "modelSettings": {
    "claude-fable-5-2": {
      "effortLevel": "high"
    },
    "claude-opus-5-5": {
      "effortLevel": "xhigh"
    }
  },
  "tui": "fullscreen",
  "showThinkingSummaries": false,
  "skipDangerousModePermissionPrompt": true,
  "theme": "dark",
  "idleCompaction": false,
  "switchModelsOnFlag": false,
  "remoteControlAtStartup": true,
  "inputNeededNotifEnabled": true,
  "agentPushNotifEnabled": true,
  "display": "summarized",
  "thinkingDisplay": "summarized"
}
