#!/usr/bin/env sh
{{ if ne .chezmoi.os "darwin" -}}
# Machine-born ssh identity: non-darwin machines use a key generated on the
# box itself (see private_dot_ssh/config.tmpl, which references a bare
# id_ed25519 off darwin). The private key never leaves this machine; register
# the public key with services instead of transporting vault keys around.
KEYFILE="$HOME/.ssh/id_ed25519"

if ! [ -f "$KEYFILE" ]
then
    mkdir -p "$HOME/.ssh"
    chmod 700 "$HOME/.ssh"
    printf "Generating machine ssh key %s\n" "$KEYFILE"
    ssh-keygen -t ed25519 -N "" -C "{{ .chezmoi.username }}@{{ .chezmoi.hostname }} machine key" -f "$KEYFILE"

    printf "\nNew machine public key:\n\n"
    cat "$KEYFILE.pub"
    cat <<'EOF'

Register it where this machine needs access, e.g.:
  gh ssh-key add ~/.ssh/id_ed25519.pub --title "$(hostname -s) machine key"
  glab ssh-key add ~/.ssh/id_ed25519.pub --title "$(hostname -s) machine key"
  ...and authorized_keys on any personal hosts.
EOF
fi
{{ end -}}
